# Copy this to terraform.tfvars and adjust if needed.
# Defaults in variables.tf already match the project's decisions — you
# usually don't need to override anything here.

aws_region          = "us-east-1"
name_prefix         = "stav-status-page"
vpc_cidr            = "10.1.0.0/16"
availability_zones  = ["us-east-1a", "us-east-1b"]
# Created manually via AWS CLI — see the comment in main.tf above the eks
# module for why, and for exactly which managed policies each role needs.
cluster_iam_role_arn = "arn:aws:iam::<account-id>:role/stav-status-page-eks-cluster-role"
node_iam_role_arn     = "arn:aws:iam::<account-id>:role/stav-status-page-eks-node-role"

cluster_version     = "1.31"
node_instance_type  = "t3.medium"
node_group_size = {
  desired = 2
  min     = 2
  max     = 2
}
